# ---- LLM (any OpenAI-compatible endpoint; all free options) ----
# Option A: Ollama running locally (100% free, private)  ->  ollama pull llama3.2
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2
LLM_API_KEY=ollama
# Option B: Groq free tier (fast hosted)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant
# LLM_API_KEY=gsk_...
# Leave LLM_BASE_URL empty to run on the built-in offline rule engine.

# ---- Telephony (Twilio trial credit; only needed for real phone calls) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+15550001111
PUBLIC_BASE_URL=https://your-tunnel.example.com   # e.g. from `cloudflared tunnel --url http://localhost:8000`

# ---- App ----
API_KEY=change-me          # protects /api/* admin endpoints
BUSINESS_CONFIG=config/business.yaml
DB_PATH=data/agent.db
SPEECH_LANGUAGE=en-US
N8N_WEBHOOK_URL=           # optional: post-call automation (see workflows/)
